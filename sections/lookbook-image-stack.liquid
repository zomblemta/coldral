{%- liquid
  assign lookbook_show = false
  if section.blocks.size > 0
    assign lookbook_show = true
  endif
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.content != blank
    assign lookbook_show = true
  endif
-%}

{%- if lookbook_show -%}
  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
  {%- assign lookbook_col_gap = section.settings.gap_between_columns | default: section.settings.gap_between_images | default: 12 -%}

  <style>
    #shopify-section-{{ section.id }} {
      --lookbook-row-gap: {{ section.settings.gap_between_images }}px;
      --lookbook-col-gap: {{ lookbook_col_gap }}px;
      --lookbook-stack-pt: {{ section.settings.padding_top }}px;
      --lookbook-stack-pb: {{ section.settings.padding_bottom }}px;
      --lookbook-image-v: {{ section.settings.image_vertical_spacing }}px;
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__wrap {
      padding-block-start: var(--lookbook-stack-pt);
      padding-block-end: var(--lookbook-stack-pb);
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__grid {
      display: grid;
      grid-template-columns: 1fr;
      row-gap: var(--lookbook-row-gap);
      column-gap: 0;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .lookbook-image-stack__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--lookbook-col-gap);
      }
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__item {
      padding-block: var(--lookbook-image-v);
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__figure {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__media {
      display: block;
      width: 100%;
      height: auto;
      vertical-align: middle;
    }

    #shopify-section-{{ section.id }} .lookbook-image-stack__caption {
      margin: 0;
      padding-block: 0.75rem 1rem;
      font-size: 0.8125rem;
      line-height: 1.4;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .lookbook-image-stack__caption {
        font-size: 0.875rem;
        padding-block: 1rem 1.25rem;
      }
    }

    #shopify-section-{{ section.id }} .section-header {
      margin-inline: 0;
      max-width: none;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .section-header .prose {
      font-size: 12px;
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .section-header .h6 {
      margin: 0 0 0.35em;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .section-header .h2 {
      margin: 0;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.45;
      letter-spacing: 0.04em;
    }
  </style>

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
    <div class="px-[14px] md:px-[50px]">
      <div class="lookbook-image-stack__wrap">
        <div class="section-stack">
          {%- render 'section-header',
            subheading: section.settings.subheading,
            heading: section.settings.heading,
            content: section.settings.content,
            text_alignment: section.settings.heading_alignment
          -%}

          {%- if section.blocks.size > 0 -%}
            <div class="lookbook-image-stack__grid">
              {%- for block in section.blocks -%}
        {%- liquid
          assign lookbook_alt = block.settings.alt_text | default: block.settings.image.alt
          if forloop.index <= 2
            assign lookbook_loading = 'eager'
          else
            assign lookbook_loading = 'lazy'
          endif
          if forloop.first
            assign lookbook_fetchpriority = 'high'
          else
            assign lookbook_fetchpriority = 'low'
          endif
        -%}

        <div class="lookbook-image-stack__item" {{ block.shopify_attributes }}>
          {%- if block.settings.caption != blank and block.settings.caption_position == 'above' -%}
            <p class="lookbook-image-stack__caption text-{{ block.settings.caption_alignment }}">
              {{- block.settings.caption | escape -}}
            </p>
          {%- endif -%}

          {%- capture media_inner -%}
            {%- if block.settings.image != blank -%}
              {%- if block.settings.image_mobile != blank -%}
                <picture>
                  <source srcset="{{ block.settings.image | image_url: width: 2400 }}" media="(min-width: 750px)">
                  <img
                    class="lookbook-image-stack__media"
                    src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                    alt="{{ lookbook_alt | escape }}"
                    loading="{{ lookbook_loading }}"
                    width="{{ block.settings.image_mobile.width }}"
                    height="{{ block.settings.image_mobile.height }}"
                    fetchpriority="{{ lookbook_fetchpriority }}"
                  >
                </picture>
              {%- else -%}
                {%- assign widths = '375,550,750,1100,1500,2000,2400,3000' -%}
                {%- capture lookbook_sizes -%}(max-width: 749px) calc(100vw - 28px), calc((100vw - 100px - {{ lookbook_col_gap }}px) / 2){%- endcapture -%}
                {{ block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'lookbook-image-stack__media',
                    widths: widths,
                    sizes: lookbook_sizes,
                    loading: lookbook_loading,
                    fetchpriority: lookbook_fetchpriority,
                    alt: lookbook_alt
                }}
              {%- endif -%}
            {%- else -%}
              {{- 'lifestyle-1' | placeholder_svg_tag: 'lookbook-image-stack__media' | replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"' -}}
            {%- endif -%}
          {%- endcapture -%}

          <figure class="lookbook-image-stack__figure">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="block focus-inset">
                {{- media_inner -}}
              </a>
            {%- else -%}
              {{- media_inner -}}
            {%- endif -%}
          </figure>

          {%- if block.settings.caption != blank and block.settings.caption_position == 'below' -%}
            <p class="lookbook-image-stack__caption text-{{ block.settings.caption_alignment }}">
              {{- block.settings.caption | escape -}}
            </p>
          {%- endif -%}
        </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.lookbook_image_stack.name",
  "class": "shopify-section--lookbook-image-stack",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.lookbook_image_stack.heading_category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Spring 2026"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:global.text.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "center",
          "label": "t:global.position.center"
        },
        {
          "value": "end",
          "label": "t:global.position.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "paragraph",
      "content": "t:sections.lookbook_image_stack.two_column_info"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook_image_stack.spacing_category"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.lookbook_image_stack.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.lookbook_image_stack.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_between_images",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.lookbook_image_stack.gap_between_images",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_between_columns",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.lookbook_image_stack.gap_between_columns",
      "info": "t:sections.lookbook_image_stack.gap_between_columns_info",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_vertical_spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.lookbook_image_stack.image_vertical_spacing",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.lookbook_image_stack.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.lookbook_image_stack.blocks.image.desktop_image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:sections.lookbook_image_stack.blocks.image.mobile_image",
          "info": "t:sections.lookbook_image_stack.blocks.image.mobile_image_info"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "t:sections.lookbook_image_stack.blocks.image.alt_text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:global.text.link_url"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.lookbook_image_stack.blocks.image.caption",
          "info": "t:sections.lookbook_image_stack.blocks.image.caption_info"
        },
        {
          "type": "select",
          "id": "caption_position",
          "label": "t:sections.lookbook_image_stack.caption_position",
          "options": [
            {
              "value": "above",
              "label": "t:sections.lookbook_image_stack.caption_position_options.above"
            },
            {
              "value": "below",
              "label": "t:sections.lookbook_image_stack.caption_position_options.below"
            }
          ],
          "default": "above"
        },
        {
          "type": "select",
          "id": "caption_alignment",
          "label": "t:global.text.alignment",
          "options": [
            {
              "value": "start",
              "label": "t:global.position.left"
            },
            {
              "value": "center",
              "label": "t:global.position.center"
            },
            {
              "value": "end",
              "label": "t:global.position.right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook_image_stack.presets.lookbook_image_stack.name",
      "settings": {
        "heading": "Spring 2026",
        "subheading": "Spring collection",
        "heading_alignment": "start",
        "gap_between_images": 12,
        "gap_between_columns": 12,
        "image_vertical_spacing": 12
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
