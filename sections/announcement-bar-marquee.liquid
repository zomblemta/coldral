{%- liquid
  assign announcement_has_visible_block = false
  for block in section.blocks
    assign item_text = block.settings.text
    if item_text == blank
      continue
    endif
    assign show_region_block = false
    assign region = block.settings.show_for_region | default: 'all'
    case region
      when 'all'
        assign show_region_block = true
      when 'usa'
        if localization.country.iso_code == 'US'
          assign show_region_block = true
        endif
      when 'australia'
        if localization.country.iso_code == 'AU'
          assign show_region_block = true
        endif
      when 'europe'
        if localization.country.continent == 'Europe' and localization.country.iso_code != 'GB' and localization.country.iso_code != 'CH'
          assign show_region_block = true
        endif
      when 'uk'
        if localization.country.iso_code == 'GB'
          assign show_region_block = true
        endif
      when 'canada'
        if localization.country.iso_code == 'CA'
          assign show_region_block = true
        endif
      when 'switzerland'
        if localization.country.iso_code == 'CH'
          assign show_region_block = true
        endif
    endcase
    if show_region_block
      assign announcement_has_visible_block = true
      break
    endif
  endfor
-%}
{%- if announcement_has_visible_block -%}
  <style>
    :root {
      --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};

      {%- if section.index == 1 and section.settings.enable_sticky == false -%}
        --header-scroll-tracker-offset: var(--announcement-bar-height);
      {%- endif -%}
    }

    {%- if section.settings.enable_sticky -%}
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .shopify-section--header ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-is-sticky, 0) * var(--header-height, 0px));
        z-index: 4;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} {
      --announcement-bar-marquee-font-size: {{ section.settings.mobile_font_size | divided_by: 16.0 }}rem;
      --announcement-bar-marquee-gap: {{ section.settings.item_gap }}px;
    }

    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --announcement-bar-marquee-font-size: {{ section.settings.desktop_font_size | divided_by: 16.0 }}rem;
      }
    }

    {%- if request.page_type == 'product' -%}
      @media screen and (max-width: 768px) {
        #shopify-section-{{ section.id }} .announcement-bar-marquee {
          margin-bottom: 9px;
        }
      }
    {%- endif -%}
  </style>

  <height-observer variable="announcement-bar ">
    <div class="announcement-bar-marquee">
      <marquee-text
        speed="{{ section.settings.scrolling_speed }}"
        direction="{{ section.settings.scroll_direction }}"
        {% if section.settings.pause_on_hover %}pause-on-hover{% endif %}
        class="announcement-bar-marquee__track"
      >
        <div class="announcement-bar-marquee__list">
          {%- assign announcement_first_visible = true -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign item_text = block.settings.text
              assign show_region_block = false
              assign region = block.settings.show_for_region | default: 'all'

              case region
                when 'all'
                  assign show_region_block = true
                when 'usa'
                  if localization.country.iso_code == 'US'
                    assign show_region_block = true
                  endif
                when 'australia'
                  if localization.country.iso_code == 'AU'
                    assign show_region_block = true
                  endif
                when 'europe'
                  if localization.country.continent == 'Europe' and localization.country.iso_code != 'GB' and localization.country.iso_code != 'CH'
                    assign show_region_block = true
                  endif
                when 'uk'
                  if localization.country.iso_code == 'GB'
                    assign show_region_block = true
                  endif
                when 'canada'
                  if localization.country.iso_code == 'CA'
                    assign show_region_block = true
                  endif
                when 'switzerland'
                  if localization.country.iso_code == 'CH'
                    assign show_region_block = true
                  endif
              endcase
            -%}
            {%- if show_region_block and item_text != blank -%}
              {%- unless announcement_first_visible -%}
                <span class="announcement-bar-marquee__separator" aria-hidden="true">{{ section.settings.separator }}</span>
              {%- endunless -%}
              {%- assign announcement_first_visible = false -%}
              {%- if block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="announcement-bar-marquee__item" {{ block.shopify_attributes }}>
                  <span class="prose">{{- item_text -}}</span>
                </a>
              {%- else -%}
                <span class="announcement-bar-marquee__item" {{ block.shopify_attributes }}>
                  <span class="prose">{{- item_text -}}</span>
                </span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </marquee-text>
    </div>
  </height-observer>

  <script>
    document.documentElement.style.setProperty('--announcement-bar-height', `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`);
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar ",
  "class": "shopify-section--announcement-bar-marquee",

  "max_blocks": 10,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Announce something here"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "show_for_region",
          "label": "Show for market / region",
          "options": [
            {
              "value": "all",
              "label": "All markets"
            },
            {
              "value": "usa",
              "label": "USA"
            },
            {
              "value": "australia",
              "label": "Australia"
            },
            {
              "value": "europe",
              "label": "Europe (excl. UK & Switzerland)"
            },
            {
              "value": "uk",
              "label": "UK"
            },
            {
              "value": "canada",
              "label": "Canada"
            },
            {
              "value": "switzerland",
              "label": "Switzerland"
            }
          ],
          "default": "all",
          "info": "Based on the visitor’s selected country. Europe excludes UK and Switzerland (same as product tax note logic in this theme)."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Stick to top of page"
    },
    {
      "type": "header",
      "content": "Scrolling"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 0.1,
      "max": 1.5,
      "step": 0.1,
      "label": "Scrolling speed",
      "default": 0.4
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "Scroll direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between items",
      "default": "✦",
      "info": "Character shown between items, e.g. ✦ • — ★"
    },
    {
      "type": "number",
      "id": "item_gap",
      "label": "Spacing between items",
      "default": 800
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 9,
      "max": 16,
      "unit": "px",
      "label": "Desktop text size",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 9,
      "max": 16,
      "unit": "px",
      "label": "Mobile text size",
      "default": 11
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Welcome to our store"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "International Shipping"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Easy Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
