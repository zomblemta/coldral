{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BACK IN STOCK FORM (Modal)
----------------------------------------------------------------------------------------------------------------------
Renders an x-modal with a native Shopify contact form for sold-out products.
On successful submission Shopify redirects back to the page;
form.posted_successfully? is then checked in buy-buttons.liquid to show the inline success state.

Supported variables:
* product: the product object
* selected_variant: the specific variant (optional)
* modal_id: the id for the x-modal element (required, set in buy-buttons.liquid)
{%- endcomment -%}

{%- assign bis_variant = selected_variant | default: product.selected_or_first_available_variant -%}
{%- assign bis_email_id = 'bis-email-' | append: product.id -%}
{%- assign bis_form_id  = 'bis-form-'  | append: product.id -%}

<x-modal id="{{ modal_id | escape }}" class="modal color-scheme color-scheme--dialog back-in-stock-modal">

  <h2 class="back-in-stock-modal__title" slot="header">RECEIVE NOTIFICATION</h2>

  <div class="back-in-stock-modal__body">

    <p class="back-in-stock-modal__subtitle">
      Enter your information and we will notify you when the item becomes available.
    </p>

    {%- form 'contact', id: bis_form_id, class: 'back-in-stock-modal__form' -%}

      {%- if form.errors -%}
        <div class="back-in-stock-modal__error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[tags]"    value="back-in-stock">
      <input type="hidden" name="contact[subject]" value="Back in stock request: {{ product.title | escape }}">
      <input
        class="back-in-stock-modal__body-input"
        type="hidden"
        name="contact[body]"
        value="Please notify me when {{ product.title | escape }} is back in stock.&#10;Variant: {{ bis_variant.title | escape }}&#10;Product URL: {{ shop.url }}{{ product.url }}"
      >

      <div class="back-in-stock-modal__field">
        <input
          type="email"
          name="contact[email]"
          id="{{ bis_email_id }}"
          class="back-in-stock-modal__email-input"
          placeholder="Enter your email"
          required
          autocomplete="email"
        >
      </div>

      <p class="back-in-stock-modal__privacy">
        For more information about our privacy practices (including your right to withdraw your consent), take a look at our
        {%- if shop.privacy_policy.url != blank -%}
          <a href="{{ shop.privacy_policy.url }}" class="back-in-stock-modal__privacy-link">Privacy Policy</a>.
        {%- else -%}
          Privacy Policy.
        {%- endif -%}
      </p>

      {%- render 'button', type: 'submit', content: 'Notify Me', stretch: true -%}

    {%- endform -%}

  </div>
</x-modal>

{%- comment -%}
  If the previous contact form submission had errors, auto-reopen the modal on page load
  so the user can see the validation messages without manually clicking the trigger again.
{%- endcomment -%}
{%- if form.errors -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById({{ modal_id | json }});
      if (modal && typeof modal.show === 'function') modal.show();
    });
  </script>
{%- endif -%}

<script>
  (() => {
    const modalId = {{ modal_id | json }};
    const bodyInput = document.querySelector(`#${CSS.escape(modalId)} .back-in-stock-modal__body-input`);

    // Swap buy-buttons ↔ notify trigger when the selected variant changes
    document.addEventListener('variant:change', (e) => {
      const variant = e.detail?.variant;
      if (!variant) return;

      const trigger = document.querySelector(`[aria-controls="${modalId}"]`);
      if (!trigger) return;

      const container = trigger.closest('.v-stack');
      const buyButtons = container?.querySelector('buy-buttons');

      if (variant.available) {
        if (buyButtons) buyButtons.hidden = false;
        trigger.hidden = true;
      } else {
        if (buyButtons) buyButtons.hidden = true;
        trigger.hidden = false;

        // Keep the body text in sync with the newly selected variant
        if (bodyInput && variant.title && variant.title !== 'Default Title') {
          bodyInput.value = bodyInput.value.replace(/Variant: [^\n]+/, `Variant: ${variant.title}`);
        }
      }
    });
  })();
</script>

<style>
  /* ── Modal header ── */
  .back-in-stock-modal .back-in-stock-modal__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Modal body wrapper ── */
  .back-in-stock-modal__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Bold description ── */
  .back-in-stock-modal__subtitle {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.55;
    margin: 0;
  }

  /* ── Form layout ── */
  .back-in-stock-modal__form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── Field ── */
  .back-in-stock-modal__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* ── Email input (underline style) ── */
  .back-in-stock-modal__email-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0.5rem 0;
    font-size: 1rem;
    font-family: inherit;
    color: inherit;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .back-in-stock-modal__email-input::placeholder {
    color: inherit;
    opacity: 0.55;
  }

  /* ── Privacy text ── */
  .back-in-stock-modal__privacy {
    font-size: 0.8125rem;
    line-height: 1.6;
    opacity: 0.7;
    margin: 0;
  }

  .back-in-stock-modal__privacy-link {
    text-decoration: underline;
    color: inherit;
  }

  /* ── Validation errors from Shopify ── */
  .back-in-stock-modal__error {
    font-size: 0.8125rem;
    color: rgb(180 27 27);
    margin-top: -0.5rem;
  }
</style>
