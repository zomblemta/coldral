{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BACK IN STOCK FORM (Modal) — Klaviyo Back-in-Stock Subscription
----------------------------------------------------------------------------------------------------------------------
Submits the email + variant ID directly to the Klaviyo V1 Back in Stock API.
Success / error states are handled in JS (no page reload required).

Supported variables:
* product: the product object
* selected_variant: the currently selected variant (optional, falls back to first available)
* modal_id: the HTML id of the <x-modal> element (required, set by buy-buttons.liquid)

Configuration:
* Set KLAVIYO_PUBLIC_KEY below to your Klaviyo public/site API key.
{%- endcomment -%}

{%- assign bis_variant  = selected_variant | default: product.selected_or_first_available_variant -%}
{%- assign bis_form_id  = 'bis-form-'  | append: product.id -%}
{%- assign bis_email_id = 'bis-email-' | append: product.id -%}

<x-modal id="{{ modal_id | escape }}" class="modal color-scheme color-scheme--dialog back-in-stock-modal">

  <h2 class="back-in-stock-modal__title" slot="header">RECEIVE NOTIFICATION</h2>

  <div class="back-in-stock-modal__body">

    <div class="back-in-stock-modal__form-wrap">

      <p class="back-in-stock-modal__subtitle">
        Enter your information and we will notify you when the item becomes available.
      </p>

      <form id="{{ bis_form_id }}" class="back-in-stock-modal__form" novalidate>
        {%- comment -%} Tracks the currently selected variant — updated via JS on variant:change {%- endcomment -%}
        <input type="hidden" name="variant_id" value="{{ bis_variant.id }}">

        <div class="back-in-stock-modal__field">
          <input
            type="email"
            name="email"
            id="{{ bis_email_id }}"
            class="back-in-stock-modal__email-input"
            placeholder="Enter your email"
            required
            autocomplete="email"
          >
        </div>

        <p class="back-in-stock-modal__privacy">
          For more information about our privacy practices (including your right to withdraw your consent), take a look at our
          {%- if shop.privacy_policy.url != blank -%}
            <a href="{{ shop.privacy_policy.url }}" class="back-in-stock-modal__privacy-link">Privacy Policy</a>.
          {%- else -%}
            Privacy Policy.
          {%- endif -%}
        </p>

        <div class="back-in-stock-modal__error" hidden role="alert">
          Something went wrong. Please try again.
        </div>

        {%- render 'button', type: 'submit', content: 'Notify Me', stretch: true -%}
      </form>

    </div>

    <div class="back-in-stock-modal__success" hidden role="status">
      <p class="back-in-stock-modal__success-title">You're on the list!</p>
      <p class="back-in-stock-modal__success-msg">We'll send you an email as soon as this item is back in stock.</p>
    </div>

  </div>
</x-modal>

<script>
  (() => {
    // ─── Configuration ────────────────────────────────────────────────────────
    // Replace with your Klaviyo public API key (found in Klaviyo → Account → API Keys)
    const KLAVIYO_PUBLIC_KEY = 'QNZ4Cy';
    // ─────────────────────────────────────────────────────────────────────────

    const modalId    = {{ modal_id | json }};
    const modal      = document.getElementById(modalId);
    if (!modal) return;

    const form       = document.getElementById({{ bis_form_id | json }});
    const emailInput = form.querySelector('[name="email"]');
    const variantInput = form.querySelector('[name="variant_id"]');
    const successEl  = modal.querySelector('.back-in-stock-modal__success');
    const formWrap   = modal.querySelector('.back-in-stock-modal__form-wrap');
    const errorEl    = form.querySelector('.back-in-stock-modal__error');

    // ── Klaviyo Back in Stock submission ──────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput.value.trim();
      if (!email) { emailInput.focus(); return; }

      const submitBtn = form.querySelector('[type="submit"]');
      submitBtn.disabled = true;
      errorEl.hidden = true;

      // Shopify variant ID must be prefixed for Klaviyo's catalog
      const variantId = `$shopify:::$default:::${variantInput.value}`;

      const payload = {
        data: {
          type: 'back-in-stock-subscription',
          attributes: {
            profile: {
              data: {
                type: 'profile',
                attributes: { email }
              }
            },
            channels: ['EMAIL']
          },
          relationships: {
            variant: {
              data: {
                type: 'catalog-variant',
                id: variantId
              }
            }
          }
        }
      };

      try {
        const response = await fetch(
          `https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=${KLAVIYO_PUBLIC_KEY}`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'revision': '2024-02-15'
            },
            body: JSON.stringify(payload)
          }
        );

        // Klaviyo returns 202 Accepted on success (no response body)
        if (response.status === 202) {
          formWrap.hidden = true;
          successEl.hidden = false;
        } else {
          const err = await response.json().catch(() => ({}));
          console.error('Klaviyo error:', err);
          throw new Error('klaviyo error');
        }
      } catch {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });

    // ── Reset form state when modal is closed ─────────────────────────────────
    modal.addEventListener('close', () => {
      setTimeout(() => {
        formWrap.hidden  = false;
        successEl.hidden = true;
        form.reset();
        errorEl.hidden = true;
        const submitBtn = form.querySelector('[type="submit"]');
        if (submitBtn) submitBtn.disabled = false;
      }, 300);
    });

    // ── Sync variant when user switches size / colour ─────────────────────────
    document.addEventListener('variant:change', (e) => {
      const variant = e.detail?.variant;
      if (!variant) return;

      // Keep the hidden variant_id in sync
      if (variantInput) variantInput.value = variant.id;

      const trigger   = document.querySelector(`[aria-controls="${modalId}"]`);
      if (!trigger) return;
      const container = trigger.closest('.v-stack');
      const buyButtons = container?.querySelector('buy-buttons');

      if (variant.available) {
        if (buyButtons) buyButtons.hidden = false;
        trigger.hidden = true;
      } else {
        if (buyButtons) buyButtons.hidden = true;
        trigger.hidden = false;
      }
    });
  })();
</script>

<style>
  /* ── Modal header ── */
  .back-in-stock-modal .back-in-stock-modal__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Modal body wrapper ── */
  .back-in-stock-modal__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Bold description ── */
  .back-in-stock-modal__subtitle {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.55;
    margin: 0;
  }

  /* ── Form layout ── */
  .back-in-stock-modal__form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── Field ── */
  .back-in-stock-modal__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* ── Email input (underline style) ── */
  .back-in-stock-modal__email-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0.5rem 0;
    font-size: 1rem;
    font-family: inherit;
    color: inherit;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .back-in-stock-modal__email-input::placeholder {
    color: inherit;
    opacity: 0.55;
  }

  /* ── Privacy text ── */
  .back-in-stock-modal__privacy {
    font-size: 0.8125rem;
    line-height: 1.6;
    opacity: 0.7;
    margin: 0;
  }

  .back-in-stock-modal__privacy-link {
    text-decoration: underline;
    color: inherit;
  }

  /* ── Error ── */
  .back-in-stock-modal__error {
    font-size: 0.8125rem;
    color: rgb(180 27 27);
    margin-top: -0.5rem;
  }

  /* ── Success state ── */
  .back-in-stock-modal__success {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .back-in-stock-modal__success-title {
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0;
  }

  .back-in-stock-modal__success-msg {
    font-size: 0.875rem;
    opacity: 0.7;
    margin: 0;
    line-height: 1.6;
  }
</style>
